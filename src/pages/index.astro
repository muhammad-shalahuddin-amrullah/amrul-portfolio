---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout 
    title="Freelance IT Support"
    description="Based in Surabaya. I bridge the gap between intuitive UI/UX design and robust technical functionality through Web Development and IT Support."
>
    <div id="intro-view">
        <!-- KIRI: CONTENT & BUTTONS -->
        <div class="intro-content">
            <div class="status-badge">
                <span class="status-dot"></span> Open to Work
            </div>
            
            <!-- Nama yang sudah diubah -->
            <h1>Shalahuddin<br><span class="serif">Amrullah</span></h1>

            <!-- Signature di bawah sudah dihapus -->
            <p class="desc">
                IT Support, UI/UX Designer & Web Developer based in Surabaya. I bridge the gap between intuitive design and robust technical functionality.
            </p>
            
            <div class="hero-actions">
                <!-- Dua Tombol Utama -->
                <div class="intro-buttons">
                    <a href="/portfolio" class="btn-primary">
                        View Portfolio <i class="fas fa-arrow-right"></i>
                    </a>
                    
                    <a href="/services" class="btn-secondary highlight">
                        <i class="fas fa-layer-group"></i> Explore Services
                    </a>
                </div>
                
                <!-- Link Arsip di Bawah -->
                <a href="https://amrul.framer.media/" target="_blank" class="archive-link">
                    <i class="fas fa-history"></i> View my old Framer archive ↗
                </a>
            </div>
        </div>

        <!-- KANAN: BENTO WALL -->
        <div class="intro-visual">
            <div class="bento-scroll-container">
                <div class="bento-grid">
                    <div class="bento-item item-large"><img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=800" alt="Code"></div>
                    <div class="bento-item item-tall"><img src="https://images.unsplash.com/photo-1561070791-2526d30994b5?q=80&w=500" alt="Design"></div>
                    <div class="bento-item item-wide"><img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800" alt="Data"></div>
                    <div class="bento-item item-small"><img src="https://images.unsplash.com/photo-1542831371-29b0f74f9713?q=80&w=500" alt="Code"></div>
                    <div class="bento-item item-small"><img src="https://images.unsplash.com/photo-1618477388954-7852f32655c7?q=80&w=500" alt="Tech"></div>
                    <div class="bento-item item-wide"><img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=800" alt="UI"></div>
                </div>
                <!-- Duplicate for infinite scroll -->
                <div class="bento-grid">
                    <div class="bento-item item-large"><img src="https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=800" alt="Code"></div>
                    <div class="bento-item item-tall"><img src="https://images.unsplash.com/photo-1561070791-2526d30994b5?q=80&w=500" alt="Design"></div>
                    <div class="bento-item item-wide"><img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=800" alt="Data"></div>
                    <div class="bento-item item-small"><img src="https://images.unsplash.com/photo-1542831371-29b0f74f9713?q=80&w=500" alt="Code"></div>
                    <div class="bento-item item-small"><img src="https://images.unsplash.com/photo-1618477388954-7852f32655c7?q=80&w=500" alt="Tech"></div>
                    <div class="bento-item item-wide"><img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=800" alt="UI"></div>
                </div>
            </div>
        </div>
    </div>
</BaseLayout>

<style>
    #intro-view { display: flex; width: 100%; height: 100vh; }
    .intro-content { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 40px 10%; z-index: 10; background: var(--bg-main); }
    .status-badge { display: inline-flex; align-items: center; gap: 8px; font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; font-weight: 700; padding: 8px 16px; border: 1px solid var(--border-color); border-radius: 50px; width: max-content; margin-bottom: 30px; color: var(--text-main); }
    .status-dot { width: 8px; height: 8px; background-color: var(--accent-green); border-radius: 50%; box-shadow: 0 0 8px var(--accent-green);}
    .intro-content h1 { font-family: var(--font-sans); font-size: clamp(3.5rem, 6vw, 5.5rem); font-weight: 900; line-height: 1; letter-spacing: -0.04em; margin-bottom: 20px;}
    .intro-content h1 .serif { font-family: var(--font-serif); font-style: italic; font-weight: 400; color: var(--text-muted);}
    .intro-content p.desc { font-size: 1.1rem; color: var(--text-muted); line-height: 1.6; max-width: 500px; margin-bottom: 40px;}
    .intro-buttons { display: flex; gap: 15px; flex-wrap: wrap; }
    
    .btn-primary { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: var(--accent-green); color: #000; padding: 16px 32px; border-radius: 50px; font-size: 14px; font-weight: 700; font-family: var(--font-sans); text-transform: uppercase; text-decoration: none; transition: 0.3s; }
    .btn-primary:hover { background: #000; color: var(--accent-green); }
    .btn-secondary { display: inline-flex; align-items: center; justify-content: center; gap: 10px; background: transparent; color: var(--text-muted); border: 1px solid var(--border-color); padding: 16px 32px; border-radius: 50px; font-size: 14px; font-weight: 600; font-family: var(--font-sans); text-decoration: none; transition: 0.3s;}
    .btn-secondary:hover { color: var(--text-main); border-color: var(--text-main); background: var(--bg-alt); }

    .intro-visual { flex: 1; position: relative; overflow: hidden; background-color: var(--bg-alt); border-left: 1px solid var(--border-color); display: none; }
    @media (min-width: 1024px) { .intro-visual { display: block; } }
    .bento-scroll-container { 
        display: flex; 
        width: max-content; 
        height: 100vh; 
        gap: 20px; 
        padding: 20px; 
        box-sizing: border-box; 
        /* Tambahkan delay 0.5s di sini (sebelum kata infinite) */
        animation: scrollBento 70s linear 0.5s infinite; 
        
        will-change: transform;
        -webkit-backface-visibility: hidden;
        backface-visibility: hidden;
    }
    .bento-grid { display: grid; grid-template-columns: repeat(4, 30vh); grid-template-rows: repeat(3, 30vh); gap: 20px; grid-auto-flow: dense; }
    .bento-item { overflow: hidden; border-radius: 12px; background: #eaeaea; }
    .bento-item img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(100%) opacity(0.5); transition: all 0.5s ease; }
    .bento-item:hover img { filter: grayscale(0%) opacity(1); }
    .item-large { grid-column: span 2; grid-row: span 2; }
    .item-wide  { grid-column: span 2; grid-row: span 1; } 
    .item-tall  { grid-column: span 1; grid-row: span 2; } 
    .item-small { grid-column: span 1; grid-row: span 1; }
    @keyframes scrollBento { 
        0% { transform: translate3d(0, 0, 0); } 
        100% { transform: translate3d(calc(-50% - 10px), 0, 0); } 
    }
    /* Wrapper untuk keseluruhan tombol & link bawah */
    .hero-actions { display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
    
    /* Tombol Utama (Berdampingan) */
    .intro-buttons { display: flex; gap: 15px; flex-wrap: wrap; }
    
    /* Modifikasi sedikit untuk tombol secondary agar lebih tegas */
    .btn-secondary.highlight { 
        border-color: var(--text-main); 
        color: var(--text-main); 
    }
    .btn-secondary.highlight:hover {
        background: var(--text-main);
        color: var(--bg-main);
    }

    /* Style untuk Link Arsip di bawah */
    .archive-link { 
        font-family: var(--font-mono); 
        font-size: 13px; 
        font-weight: 500; 
        color: var(--text-muted); 
        text-decoration: none; 
        display: inline-flex; 
        align-items: center; 
        gap: 8px; 
        transition: 0.2s; 
        padding-left: 5px;
    }
    .archive-link:hover { 
        color: var(--text-main); 
        transform: translateX(5px); 
    }
</style>