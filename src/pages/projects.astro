---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
    title="All Projects & Archive | S. Amrullah"
    description="A complete archive of my works in UI/UX Design, Web Development, and IT Support."
>
    <div class="container">
        <!-- NAVBAR -->
        <Navbar activeMenu="projects" />

        <!-- HEADER HALAMAN -->
        <header class="page-header">
            <h1>All <span class="serif">Projects.</span></h1>
            <p style="font-size: 1.1rem; color: var(--text-muted); max-width: 600px;">A complete archive of my works, experiments, and case studies.</p>
        </header>

        <!-- KATEGORI FILTER -->
        <div class="filters" id="filter-container">
            <button class="filter-btn active" data-category="All">All Works</button>
            <button class="filter-btn" data-category="Web Development">Web Development</button>
            <button class="filter-btn" data-category="UI/UX Design">UI/UX Design</button>
            <button class="filter-btn" data-category="IT Support">IT Support</button>
        </div>

        <!-- GRID KARTU PROJEK (Akan diisi oleh Javascript) -->
        <div class="projects-grid" id="project-container">
            <!-- Data akan muncul di sini -->
        </div>

        <!-- PAGINATION -->
        <div class="pagination" id="pagination-container">
            <!-- Tombol angka akan muncul di sini -->
        </div>
    </div>

    <!-- FOOTER -->
    <Footer />
</BaseLayout>

<!-- CSS SCOPED UNTUK HEADER & FILTER -->
<style>
    .container { max-width: 1200px; margin: 0 auto; padding: 0 5%; }
    
    .page-header { padding: 60px 0 40px; text-align: left; border-bottom: 1px solid var(--border-color); margin-bottom: 40px;}
    .page-header h1 { font-family: var(--font-sans); font-size: clamp(2.5rem, 5vw, 4.5rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.03em; margin-bottom: 20px;}
    .page-header .serif { font-family: var(--font-serif); font-style: italic; color: var(--text-muted); font-weight: 400;}

    .filters { display: flex; gap: 10px; margin-bottom: 40px; flex-wrap: wrap; }
    .filter-btn {
        background: var(--bg-alt); border: 1px solid var(--border-color); color: var(--text-muted);
        padding: 8px 16px; border-radius: 50px; font-family: var(--font-mono); font-size: 12px;
        cursor: pointer; transition: 0.3s; text-transform: uppercase; font-weight: 600;
    }
    .filter-btn.active, .filter-btn:hover { background: var(--text-main); color: var(--bg-main); border-color: var(--text-main); }
    
    .pagination { display: flex; justify-content: center; align-items: center; gap: 10px; margin: 60px 0 80px; }
</style>

<!-- CSS GLOBAL UNTUK DESAIN KARTU PROJEK (MENGAMBIL DARI HTML ANDA) -->
<style is:global>
    /* Menggunakan desain persis seperti di index.html Anda */
    .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 40px; min-height: 500px; align-content: start;}
    
    .project-card { display: block; text-decoration: none; color: var(--text-main); animation: fadeIn 0.4s ease-out;}
    
    .project-thumb { 
        width: 100%; aspect-ratio: 4/3; border-radius: 12px; overflow: hidden; 
        margin-bottom: 20px; background: var(--bg-alt); border: 1px solid var(--border-color); 
    }
    .project-thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
    .project-card:hover .project-thumb img { transform: scale(1.05); }
    
    .project-tags { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); margin-bottom: 10px; text-transform: uppercase;}
    .project-title { font-family: var(--font-sans); font-size: 1.5rem; font-weight: 800; margin-bottom: 10px; letter-spacing: -0.02em;}
    .project-desc { font-family: var(--font-sans); font-size: 0.95rem; color: var(--text-muted); line-height: 1.6; font-weight: 400;}

    /* Style Tombol Pagination */
    .page-btn {
        width: 40px; height: 40px; border-radius: 50%; background: var(--bg-alt); border: 1px solid var(--border-color);
        display: flex; justify-content: center; align-items: center; font-family: var(--font-mono); font-weight: 700;
        cursor: pointer; transition: 0.3s; color: var(--text-main); font-size: 14px;
    }
    .page-btn:hover:not(:disabled) { background: #e0e0e0; }
    .page-btn.active { background: var(--accent-green); border-color: var(--accent-green); color: #000; }
    .page-btn:disabled { opacity: 0.4; cursor: not-allowed; }
</style>

<!-- JAVASCRIPT (is:inline agar logika jalan sempurna di Astro) -->
<script is:inline>
    // Anda bisa menambah projek di sini tanpa batas!
    const allProjects = [
        {
            title: "Alternative Wiz Lamp Control",
            category: "Web Development",
            tags: "Web Design / Web Dev",
            image: "https://images.unsplash.com/photo-1555066931-4365d14bab8c?q=80&w=800",
            link: "https://amrul.framer.media/",
            desc: "A custom web interface designed to provide alternative, seamless control for Wiz smart lamps."
        },
        {
            title: "Wiz Inspector Extension",
            category: "Web Development",
            tags: "Web Development",
            image: "https://images.unsplash.com/photo-1498050108023-c5249f4df085?q=80&w=800",
            link: "https://amrul.framer.media/",
            desc: "A browser extension built to inspect and debug Wiz smart home configurations easily."
        },
        {
            title: "DokterCaRes Landing Page",
            category: "UI/UX Design",
            tags: "UI/UX Design / SEO",
            image: "https://images.unsplash.com/photo-1561070791-2526d30994b5?q=80&w=800",
            link: "https://amrul.framer.media/",
            desc: "Redesigned the landing page with user research, and optimized it for search engines."
        },
        {
            title: "EastTech Hero Section",
            category: "UI/UX Design",
            tags: "UI/UX Design",
            image: "https://images.unsplash.com/photo-1522071820081-009f0129c71c?q=80&w=800",
            link: "https://amrul.framer.media/",
            desc: "Modern, high-conversion hero section design for EastTech company profile."
        },
        {
            title: "Server Firewall Configurator",
            category: "IT Support",
            tags: "IT Support / Linux",
            image: "https://images.unsplash.com/photo-1542831371-29b0f74f9713?q=80&w=800",
            link: "#",
            desc: "Automated shell script to easily manage UFW firewall settings on Ubuntu servers."
        }
    ];

    let currentCategory = 'All';
    let currentPage = 1;
    const itemsPerPage = 6; // Menampilkan 6 kotak per halaman

    function getFilteredProjects() {
        if (currentCategory === 'All') return allProjects;
        return allProjects.filter(p => p.category === currentCategory);
    }

    function renderProjects() {
        const container = document.getElementById('project-container');
        if(!container) return;
        
        container.innerHTML = ''; 

        const filteredProjects = getFilteredProjects();
        const startIndex = (currentPage - 1) * itemsPerPage;
        const endIndex = startIndex + itemsPerPage;
        const projectsToRender = filteredProjects.slice(startIndex, endIndex);

        if(projectsToRender.length === 0) {
            container.innerHTML = '<p style="color: var(--text-muted); grid-column: 1/-1;">No projects found in this category.</p>';
            renderPagination(0);
            return;
        }

        projectsToRender.forEach(project => {
            // HTML ini 100% SAMA dengan desain di index.html Anda!
            const card = `
                <a href="${project.link}" target="_blank" class="project-card">
                    <div class="project-thumb">
                        <img src="${project.image}" alt="${project.title}">
                    </div>
                    <div class="project-tags">${project.tags}</div>
                    <h3 class="project-title">${project.title}</h3>
                    <p class="project-desc">${project.desc}</p>
                </a>
            `;
            container.insertAdjacentHTML('beforeend', card);
        });

        renderPagination(filteredProjects.length);
    }

    function renderPagination(totalItems) {
        const paginationContainer = document.getElementById('pagination-container');
        if(!paginationContainer) return;

        paginationContainer.innerHTML = ''; 
        
        const totalPages = Math.ceil(totalItems / itemsPerPage);
        if (totalPages <= 1) return; 

        const prevBtn = document.createElement('button');
        prevBtn.className = 'page-btn';
        prevBtn.innerHTML = '<i class="fas fa-chevron-left"></i>';
        prevBtn.disabled = currentPage === 1;
        prevBtn.onclick = () => { currentPage--; renderProjects(); scrollToTop(); };
        paginationContainer.appendChild(prevBtn);

        for (let i = 1; i <= totalPages; i++) {
            const numBtn = document.createElement('button');
            numBtn.className = `page-btn ${i === currentPage ? 'active' : ''}`;
            numBtn.innerText = i;
            numBtn.onclick = () => { currentPage = i; renderProjects(); scrollToTop(); };
            paginationContainer.appendChild(numBtn);
        }

        const nextBtn = document.createElement('button');
        nextBtn.className = 'page-btn';
        nextBtn.innerHTML = '<i class="fas fa-chevron-right"></i>';
        nextBtn.disabled = currentPage === totalPages;
        nextBtn.onclick = () => { currentPage++; renderProjects(); scrollToTop(); };
        paginationContainer.appendChild(nextBtn);
    }

    function filterProjects(category) {
        currentCategory = category;
        currentPage = 1; 
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.classList.remove('active');
            if(btn.dataset.category === category) {
                btn.classList.add('active');
            }
        });
        renderProjects();
    }

    function scrollToTop() {
        document.querySelector('.page-header').scrollIntoView({ behavior: 'smooth' });
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.filter-btn').forEach(btn => {
            btn.addEventListener('click', (e) => filterProjects(e.target.dataset.category));
        });
        renderProjects();
    });
</script>