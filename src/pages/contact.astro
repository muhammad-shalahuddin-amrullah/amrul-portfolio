---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
---

<BaseLayout 
    title="Get in Touch | Muhammad Shalahuddin Amrullah"
    description="Let's work together. Reach out for freelance opportunities, web development, and UI/UX design."
>
    <!-- Container menggunakan flexbox untuk menengahkan konten -->
    <div class="container" style="min-height: 100vh; display: flex; flex-direction: column;">
        <!-- Panggil Navbar dan aktifkan menu 'contact' -->
        <Navbar activeMenu="contact" />
        
        <!-- Area Konten Utama Contact (Di tengah layar) -->
        <div class="contact-wrapper">
            <div class="contact-content">
                <p class="project-tags">AVAILABLE FOR FREELANCE</p>
                <h1 class="contact-title">Let's Work <span class="serif">Together.</span></h1>
                
                <p class="contact-desc">
                    Whether you have a project in mind, need IT support, or just want to chat about tech and design, feel free to reach out.
                </p>

                <div class="email-group">
                    <a href="mailto:amrul2005334@gmail.com" class="email-link">amrul2005334@gmail.com</a>
                    <button onclick="copyEmail(this, 'amrul2005334@gmail.com')" class="copy-btn">
                        <i class="far fa-copy"></i> Copy
                    </button>
                </div>

                <div class="footer-social">
                    <a href="https://www.instagram.com/a.mrllh__/" target="_blank"><i class="fab fa-instagram"></i></a>
                    <a href="https://dribbble.com/Muhammad-Shalahudin-Amrullah" target="_blank"><i class="fab fa-dribbble"></i></a>
                    <a href="https://www.linkedin.com/in/amrullah200533428050/" target="_blank"><i class="fab fa-linkedin-in"></i></a>
                </div>
            </div>
        </div>
        
        <!-- Copyright Simple di paling bawah -->
        <p style="text-align:center; font-family:var(--font-mono); font-size: 10px; color:var(--text-muted); text-transform: uppercase; padding-bottom: 40px;">
            © 2025 Muhammad Shalahuddin Amrullah. All Rights Reserved.
        </p>
    </div>
</BaseLayout>

<!-- Script Copy Email -->
<script is:inline>
    function copyEmail(buttonElement, email) {
        navigator.clipboard.writeText(email).then(() => {
            const originalHTML = '<i class="far fa-copy"></i> Copy';
            buttonElement.innerHTML = '<i class="fas fa-check"></i> Copied!';
            buttonElement.classList.add('copied');
            setTimeout(() => {
                buttonElement.innerHTML = originalHTML;
                buttonElement.classList.remove('copied');
            }, 2500);
        }).catch(err => {
            alert('Gagal menyalin email. Silakan block dan copy manual.');
        });
    }
</script>

<!-- CSS Khusus Halaman Contact -->
<style>
    .contact-wrapper { 
        flex: 1; 
        display: flex; 
        align-items: center; 
        justify-content: center; 
        text-align: center; 
        padding: 60px 0; 
    }
    
    .contact-content { max-width: 800px; margin: 0 auto; }

    .project-tags { font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 1px; margin-bottom: 20px;}
    
    .contact-title { font-family: var(--font-sans); font-size: clamp(3.5rem, 8vw, 6rem); font-weight: 900; line-height: 1.1; letter-spacing: -0.04em; margin-bottom: 30px; color: var(--text-main);}
    .contact-title .serif { font-family: var(--font-serif); font-style: italic; color: var(--text-muted); font-weight: 400;}
    
    .contact-desc { font-size: 1.2rem; color: var(--text-muted); line-height: 1.6; margin-bottom: 50px; max-width: 600px; margin-left: auto; margin-right: auto;}

    .email-group { display: inline-flex; align-items: center; background: var(--bg-alt); border: 1px solid var(--border-color); border-radius: 50px; padding: 6px; transition: all 0.3s ease; margin-bottom: 60px;}
    .email-group:hover { border-color: var(--text-muted); box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .email-link { padding: 12px 24px; color: var(--text-main); text-decoration: none; font-weight: 600; font-size: 1.1rem; font-family: var(--font-sans); }
    
    .copy-btn { background: var(--accent-green); color: #000; border: none; padding: 14px 28px; border-radius: 50px; font-weight: 700; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; gap: 8px; font-family: var(--font-sans); font-size: 14px; }
    .copy-btn:hover, .copy-btn.copied { background: #000; color: var(--accent-green); }
    
    .footer-social { display: flex; gap: 20px; justify-content: center;}
    .footer-social a { width: 60px; height: 60px; border-radius: 50%; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; color: var(--text-main); text-decoration: none; font-size: 1.5rem; transition: 0.3s;}
    .footer-social a:hover { background: var(--accent-green); border-color: var(--accent-green); transform: translateY(-3px);}
    /* === TAMBAHKAN KODE INI DI STYLE CONTACT.ASTRO === */
    @media (max-width: 550px) {
        .email-group {
            display: flex;
            flex-direction: column; 
            border-radius: 20px; 
            padding: 10px;
            width: 100%;
        }
        .email-link { 
            font-size: 1rem; 
            padding: 15px 10px; 
            word-break: break-all; /* Memaksa email turun ke bawah jika layar terlalu kecil */
        } 
        .copy-btn { 
            width: 100%; 
            padding: 16px; 
            justify-content: center;
        } 
    }
</style>