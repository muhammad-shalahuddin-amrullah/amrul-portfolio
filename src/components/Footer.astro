---
const { isPortfolio } = Astro.props;
---
<footer id="contact" class={`footer ${isPortfolio ? 'no-border' : ''}`}>
    <p class="project-tags" style="margin-bottom: 10px;">AVAILABLE FOR FREELANCE</p>
    <h2>Let's Work <span class="serif">Together.</span></h2>
    
    <div class="email-group">
        <a href="mailto:amrul2005334@gmail.com" class="email-link">amrul2005334@gmail.com</a>
        <button onclick="copyEmail(this, 'amrul2005334@gmail.com')" class="copy-btn">
            <i class="far fa-copy"></i> Copy
        </button>
    </div>

    <div class="footer-social">
        <a href="https://www.instagram.com/a.mrllh__/" target="_blank"><i class="fab fa-instagram"></i></a>
        <a href="https://dribbble.com/Muhammad-Shalahudin-Amrullah" target="_blank"><i class="fab fa-dribbble"></i></a>
        <a href="https://www.linkedin.com/in/amrullah200533428050/" target="_blank"><i class="fab fa-linkedin-in"></i></a>
    </div>
    <p style="font-family:var(--font-mono); font-size: 10px; color:var(--text-muted); text-transform: uppercase; margin-top:40px;">© 2025 Muhammad Shalahuddin Amrullah. All Rights Reserved.</p>
</footer>

<script is:inline>
    function copyEmail(buttonElement, email) {
        navigator.clipboard.writeText(email).then(() => {
            const originalHTML = '<i class="far fa-copy"></i> Copy';
            buttonElement.innerHTML = '<i class="fas fa-check"></i> Copied!';
            buttonElement.classList.add('copied');
            setTimeout(() => {
                buttonElement.innerHTML = originalHTML;
                buttonElement.classList.remove('copied');
            }, 2500);
        }).catch(err => {
            alert('Gagal menyalin email. Silakan block dan copy manual.');
        });
    }
</script>

<style>
    /* Default Footer (Untuk halaman Projects & Journey) */
    .footer { padding: 60px 0; text-align: center; border-top: 1px solid var(--border-color); margin-top: 60px;}
    
    /* Footer Khusus Portfolio (Tanpa Garis & Jarak Lebih Jauh seperti HTML asli) */
    .footer.no-border { border-top: none; padding-top: 120px; margin-top: 0; }

    .footer h2 { font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 900; margin-bottom: 30px; letter-spacing: -0.04em; font-family: var(--font-sans);}
    .footer .serif { font-family: var(--font-serif); font-style: italic; color: var(--text-muted); font-weight: 400;}
    .project-tags { font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); text-transform: uppercase;}
    .footer-social { margin-top: 50px; display: flex; justify-content: center; gap: 20px; }
    .footer-social a { width: 50px; height: 50px; border-radius: 50%; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; color: var(--text-main); text-decoration: none; font-size: 1.2rem; transition: 0.3s;}
    .footer-social a:hover { background: var(--accent-green); border-color: var(--accent-green); }

    .email-group { display: inline-flex; align-items: center; background: var(--bg-alt); border: 1px solid var(--border-color); border-radius: 50px; padding: 6px; margin-top: 10px; transition: all 0.3s ease; }
    .email-group:hover { border-color: var(--text-muted); box-shadow: 0 4px 15px rgba(0,0,0,0.05); }
    .email-link { padding: 12px 24px; color: var(--text-main); text-decoration: none; font-weight: 600; font-size: 1.1rem; font-family: var(--font-sans); }
    .copy-btn { background: var(--accent-green); color: #000; border: none; padding: 14px 28px; border-radius: 50px; font-weight: 700; cursor: pointer; transition: all 0.3s ease; display: flex; align-items: center; gap: 8px; font-family: var(--font-sans); font-size: 14px; }
    .copy-btn:hover, .copy-btn.copied { background: #000; color: var(--accent-green); }
</style>